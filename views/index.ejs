<%- include('partials/head', { bodyClass: 'page-home' }) %>
<%- include('partials/header') %>

<section class="hero">
  <div class="wrap hero-inner">
    <div class="hero-title">
      <p class="eyebrow">Automóveis premium selecionados</p>
      <h1>Not new.<br><em>Just better chosen.</em></h1>
    </div>
    <div class="hero-side">
      <p class="lead">Automóveis premium usados, escolhidos um a um. Poucas viaturas, todas com histórico claro e estado verificado, explicadas ao detalhe antes de decidir.</p>
      <div class="actions">
        <a class="btn btn-gold" href="/viaturas">Ver viaturas</a>
        <a class="btn btn-line" href="/contactos">Falar connosco</a>
      </div>
    </div>
  </div>
  <div class="wrap hero-foot">
    <span><%= config.zona %></span>
    <span><%= config.horario %></span>
  </div>
</section>

<% if (destaque) { %>
<section class="featured reveal" aria-labelledby="destaque-titulo">
  <div class="wrap featured-grid">
    <a class="featured-media" href="/viaturas/<%= destaque.slug %>" tabindex="-1" aria-hidden="true">
      <% if (destaque.fotos.length) { %>
        <img src="/uploads/<%= destaque.fotos[0] %>" alt="">
      <% } else { %>
        <%- include('partials/placeholder') %>
      <% } %>
    </a>
    <div class="featured-info">
      <p class="eyebrow"><%= destaque.estado === 'brevemente' ? 'Chega em breve' : 'Em destaque' %></p>
      <h2 id="destaque-titulo"><%= carTitle(destaque) %></h2>
      <% if (destaque.versao) { %><p class="versao"><%= destaque.versao %></p><% } %>
      <dl class="mini-specs">
        <% if (destaque.ano) { %><div><dt>Ano</dt><dd><%= destaque.ano %></dd></div><% } %>
        <% if (destaque.km != null) { %><div><dt>Quilómetros</dt><dd><%= formatKm(destaque.km) %></dd></div><% } %>
        <% if (destaque.combustivel) { %><div><dt>Combustível</dt><dd><%= destaque.combustivel %></dd></div><% } %>
        <% if (destaque.caixa) { %><div><dt>Caixa</dt><dd><%= destaque.caixa %></dd></div><% } %>
      </dl>
      <p class="preco"><%= formatPrice(destaque.preco) %></p>
      <a class="btn btn-gold" href="/viaturas/<%= destaque.slug %>">Ver viatura</a>
    </div>
  </div>
</section>
<% } %>

<section class="process reveal" aria-labelledby="processo-titulo">
  <div class="wrap">
    <p class="eyebrow">O método Caribi</p>
    <h2 id="processo-titulo">Como escolhemos <em>cada viatura</em></h2>
    <ol class="steps">
      <li><h3>Origem</h3><p>Só aceitamos viaturas com histórico de manutenção e proveniência que conseguimos confirmar.</p></li>
      <li><h3>Inspeção</h3><p>Verificamos mecânica, eletrónica, carroçaria e interior antes de qualquer viatura entrar em stock.</p></li>
      <li><h3>Preparação</h3><p>Tratamos do que for preciso para que o carro chegue até ti como deve estar.</p></li>
      <li><h3>Entrega</h3><p>Explicamos tudo o que fizemos e entregamos a documentação completa.</p></li>
    </ol>
  </div>
</section>

<section class="stock reveal" aria-labelledby="stock-titulo">
  <div class="wrap">
    <div class="section-head">
      <div>
        <p class="eyebrow">A coleção</p>
        <h2 id="stock-titulo">Em stock</h2>
      </div>
      <a class="link" href="/viaturas">Ver todas as viaturas</a>
    </div>
    <% if (outras.length) { %>
      <div class="car-grid">
        <% outras.forEach(function (car) { %><%- include('partials/car-card', { car }) %><% }) %>
      </div>
    <% } else { %>
      <div class="empty">
        <p>O stock está a ser renovado. Diz-nos o que procuras e avisamos-te quando chegar.</p>
        <a class="btn btn-line" href="<%= waLink('Olá! Procuro uma viatura e gostava de ser avisado quando tiverem algo do género.') %>" target="_blank" rel="noopener">Dizer o que procuro</a>
      </div>
    <% } %>
  </div>
</section>

<section class="cta-band">
  <div class="wrap cta-inner">
    <p>Procuras um modelo específico? <em>Conta-nos o que tens em mente.</em></p>
    <a class="btn btn-gold" href="<%= waLink('Olá! Procuro um modelo específico.') %>" target="_blank" rel="noopener">Falar por WhatsApp</a>
  </div>
</section>

<%- include('partials/footer') %>
