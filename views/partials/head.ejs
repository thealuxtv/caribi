<!doctype html>
<html lang="pt-PT">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= locals.title ? `${title} | Caribi` : 'Caribi | Automóveis premium selecionados' %></title>
  <meta name="description" content="<%= locals.description || config.descricao %>">
  <meta name="theme-color" content="#000000">
  <meta property="og:type" content="website">
  <meta property="og:site_name" content="Caribi">
  <meta property="og:title" content="<%= locals.title || 'Caribi' %>">
  <meta property="og:description" content="<%= locals.description || config.descricao %>">
  <% if (locals.ogImage) { %><meta property="og:image" content="<%= ogImage %>"><% } %>
  <link rel="icon" href="/img/favicon.png" type="image/png">
  <link rel="apple-touch-icon" href="/img/apple-touch-icon.png">
  <link rel="stylesheet" href="/fonts/marcellus/400.css">
  <link rel="stylesheet" href="/fonts/cormorant-garamond/300-italic.css">
  <link rel="stylesheet" href="/fonts/cormorant-garamond/400-italic.css">
  <link rel="stylesheet" href="/fonts/hanken-grotesk/400.css">
  <link rel="stylesheet" href="/fonts/hanken-grotesk/500.css">
  <link rel="stylesheet" href="/fonts/hanken-grotesk/600.css">
  <link rel="stylesheet" href="/css/style.css">
  <script>document.documentElement.classList.add('js')</script>
  <% if (locals.jsonLd) { %><script type="application/ld+json"><%- JSON.stringify(jsonLd).replace(/</g, '\\u003c') %></script><% } %>
</head>
<body class="<%= locals.bodyClass || '' %>">
